{{#> layout subject="Reset your Tempo password" }}
  <h1>Reset your Tempo password</h1>
  <p>You requested a password reset for your Tempo account. Click the button below to proceed and set a new password.</p>
  {{> button
      url=resetUrl
      text="Reset password"
      bgColor="#8F4032"
      textColor="#F6F1E8"
  }}
  <p>This link will expire in {{expiration}}.</p>
  <p>If you did not request this, please disregard this email.</p>
{{/layout}}
