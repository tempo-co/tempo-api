{{#> layout subject="Welcome to Tempo" }}
  <h1>Welcome to Tempo, {{name}}.</h1>
  <p>Please confirm your email address by clicking the button below.</p>
  {{> button
      url=verificationUrl
      text="Verify email"
      bgColor="#8F4032"
      textColor="#F6F1E8"
  }}
  <p>This link and code expire in {{expiration}}. You can also manually enter the code below.</p>
  {{> code-block code=code }}
  <p>If you did not sign up for Tempo, please disregard this email.</p>
{{/layout}}
