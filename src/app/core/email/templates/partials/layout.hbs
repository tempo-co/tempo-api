<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>{{subject}}</title>
    <style type="text/css">
      h1, h2, p { margin-top: 0; }
      h1 {
        color: #28252B;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.25;
        margin-bottom: 24px;
      }
      h2 {
        color: #28252B;
        font-size: 18px;
        font-weight: 600;
        line-height: 1.35;
        margin-bottom: 16px;
      }
      p {
        color: #28252B;
        font-size: 16px;
        line-height: 1.5;
        margin-bottom: 16px;
      }
      p:last-of-type { margin-bottom: 0; }
    </style>
  </head>
  <body style="
    margin: 0;
    padding: 32px 0;
    background-color: #F6F1E8;
    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: #28252B;
  ">
    <div style="
      box-sizing: border-box;
      width: calc(100% - 32px);
      max-width: 500px;
      background-color: #FBF8F1;
      padding: 24px;
      margin: 0 auto;
      border: 1px solid #D0C8B9;
      border-radius: 0;
      line-height: 1.5;
      box-shadow: 0 1px 2px 0 rgb(40 37 43 / 0.05);
    ">
      {{> @partial-block }}
    </div>
  </body>
</html>
