{{#> layout subject="Your Tempo email was changed" }}
  <h1>Your Tempo email was changed, {{name}}</h1>
  <p>You now sign in with <strong>{{newEmail}}</strong> instead of <strong>{{oldEmail}}</strong>.</p>
  <p>If you didn't make this change, reset your password and contact us right away.</p>
{{/layout}}
