[Unit]
Description=Deploy the latest successful Tempo API and web images
Wants=network-online.target
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
TimeoutStartSec=10min
User=%i
SupplementaryGroups=docker
Environment=TEMPO_DEPLOY_COMPOSE_FILE=/etc/tempo/production.compose.yml
Environment=TEMPO_DEPLOY_STATE_FILE=/var/lib/tempo-deploy/images.env
ExecStart=/usr/local/libexec/tempo-production-deploy
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/tempo-deploy
