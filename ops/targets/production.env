# Production: rootful Docker, served at http://127.0.0.1:8080/tempo/.
# shellcheck shell=bash disable=SC2034
COMPOSE_PROJECT=tempo-api-production
COMPOSE_FILE=/etc/tempo/production.compose.yml
ENV_FILE=/etc/tempo/production.env
IMAGES_FILE=/var/lib/tempo-deploy/deployed.env
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_CONFIG=/var/lib/tempo-deploy/docker-config
STATE_DIR=/var/lib/tempo-deploy
DEFAULT_TAG=main
HEALTH_URLS="http://127.0.0.1:8080/tempo/api/health http://127.0.0.1:8080/tempo/"
BEFORE_API_CHANGE=
AFTER_DEPLOY=
