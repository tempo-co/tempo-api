# Staging images are supplied only by the protected promotion workflow.
TEMPO_API_IMAGE=ghcr.io/tempo-co/tempo-api@sha256:REPLACE_WITH_64_HEX_DIGEST
TEMPO_WEB_IMAGE=ghcr.io/tempo-co/tempo-web@sha256:REPLACE_WITH_64_HEX_DIGEST

# Keep this origin on the private staging Service hostname, separate from production.
STAGING_PUBLIC_URL=https://staging.example.invalid/tempo
STAGING_WEB_HOST_PORT=8119

STAGING_DB_USERNAME=tempo_staging
STAGING_DB_PASSWORD=REPLACE_WITH_STAGING_PASSWORD
STAGING_DB_NAME=tempo_staging
SESSION_SECRET=REPLACE_WITH_STAGING_SESSION_SECRET
BANKING_SESSION_ENCRYPTION_KEY_B64=REPLACE_WITH_STAGING_KEY_B64

# These are intentionally duplicated as documentation and safety checks. The
# Compose manifest hard-codes the disabled values and does not pass provider
# credentials into the staging API container.
AI_CATEGORIZATION_ENABLED=false
AI_CATEGORIZATION_WEB_SEARCH_ENABLED=false
BANKING_INTEGRATION_ENABLED=false
