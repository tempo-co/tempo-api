# Copy to ~/.config/tempo-staging/staging.env, generate every *_SECRET/*PASSWORD/*KEY value,
# set immutable API/web image digests, and chmod 600. Do not commit the populated file.
TEMPO_API_IMAGE=ghcr.io/tempo-co/tempo-api@sha256:REPLACE_WITH_API_IMAGE_DIGEST
TEMPO_WEB_IMAGE=ghcr.io/tempo-co/tempo-web@sha256:REPLACE_WITH_WEB_IMAGE_DIGEST
STAGING_PUBLIC_URL=https://staging.example.invalid/staging
STAGING_WEB_HOST_PORT=8119
STAGING_DB_USERNAME=tempo_staging
STAGING_DB_PASSWORD=GENERATE_A_STAGING_ONLY_PASSWORD
STAGING_DB_NAME=tempo_staging

# Application secrets. Generate these locally; never reuse production values.
SESSION_SECRET=GENERATE_A_STAGING_ONLY_SECRET
SESSION_EXPIRATION=30d
BANKING_SESSION_ENCRYPTION_KEY_B64=GENERATE_A_32_BYTE_BASE64_KEY
EMAIL_VERIFICATION_EXPIRATION=1d
EMAIL_VERIFICATION_REDIS_KEY=tempo-staging-email-verification
PASSWORD_RESET_EXPIRATION=1h
PASSWORD_RESET_REDIS_KEY=tempo-staging-password-reset
THROTTLE_TTL=1m
THROTTLE_LIMIT=100

# Staging-only disabled side effects. Do not add provider private-key variables.
BANKING_INTEGRATION_ENABLED=false
AI_CATEGORIZATION_ENABLED=false
AI_CATEGORIZATION_WEB_SEARCH_ENABLED=false
