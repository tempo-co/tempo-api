[Unit]
Description=Tempo staging rootless Docker daemon
After=default.target

[Service]
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_NET=slirp4netns
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_PORT_DRIVER=slirp4netns
ExecStartPre=/usr/bin/mkdir -p %t/tempo-staging %h/.local/share/tempo-staging/docker %h/.local/state/tempo-staging/docker-exec
ExecStart=%h/bin/dockerd-rootless.sh --experimental --host=unix://%t/tempo-staging/docker.sock --data-root=%h/.local/share/tempo-staging/docker --exec-root=%h/.local/state/tempo-staging/docker-exec --pidfile=%h/.local/state/tempo-staging/docker.pid --storage-driver=fuse-overlayfs
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
LimitNOFILE=1048576

[Install]
WantedBy=default.target
