{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": "..",
	"testEnvironment": "node",
	"testRegex": "bank-transaction-categorization\\.e2e\\.spec\\.ts$",
	"transform": {
		"^.+\\.(t|j)s$": "ts-jest"
	},
	"moduleNameMapper": {
		"^@core/(.*)$": "<rootDir>/src/app/core/$1",
		"^@modules/(.*)$": "<rootDir>/src/app/modules/$1"
	},
	"setupFiles": ["<rootDir>/test/setup/e2e-categorization.env.ts"],
	"setupFilesAfterEnv": ["<rootDir>/test/setup/e2e.setup.ts", "<rootDir>/test/setup/e2e-categorization.setup.ts"]
}
